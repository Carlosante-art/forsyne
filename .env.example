# Praevictus — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env — it is in .gitignore.

# ── CORE ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ── SUPABASE (required) ──
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...         # service role key — NEVER expose to client

# ── ANTHROPIC CLAUDE API (required) ──
ANTHROPIC_API_KEY=sk-ant-api03-...

# Set to "true" during local development to pause all Claude calls
# (fallbacks take over — zero API cost during iteration)
MOCK_AI=false

# ── ENCRYPTION (required) ──
# Used to encrypt profile data at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_KEY

# ── SCHEDULED JOBS ──
# Used to authenticate cron trigger endpoints (if any are exposed)
SCHEDULE_SECRET=RANDOM_LONG_STRING

# ── SENTRY (optional) ──
# Error tracking. Leave empty to disable — Sentry is a no-op without DSN.
# Get a DSN at https://sentry.io → Create project → Node.js
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ── INTEGRATIONS: STRAVA (optional) ──
# Register app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ── INTEGRATIONS: GARMIN (optional) ──
# Register at https://developer.garmin.com/gc-developer-program/
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# ── INTEGRATIONS: DEXCOM (optional) ──
# Register at https://developer.dexcom.com/
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=

# ── INTEGRATIONS: TERRA (optional) ──
# https://tryterra.co/
TERRA_API_KEY=
TERRA_DEV_ID=

# ── EMAIL: RESEND (optional) ──
# https://resend.com/api-keys
RESEND_API_KEY=

# ── DEPLOY: RAILWAY (auto-set in production) ──
# Do not set locally — Railway sets this automatically
# RAILWAY_STATIC_URL=
